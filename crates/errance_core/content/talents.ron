// Talents (passifs). Débloqués par la maîtrise d'une voie, ils s'équipent
// dans un nombre limité d'emplacements (1 au début, 6 pour un vétéran).
// needs_equipped: true → ne marche que si un objet de la voie est porté.
[
    // ================= LABEUR (corvées) =================
    (id: "dos_de_docker", name: "Dos de docker", line: "labeur", mastery: 2,
     description: "Porter des caisses, ça forge. +12 % de PV max.",
     effects: [Stat((stat: MaxHp, kind: Percent, value: 0.12))]),
    (id: "souffle_long", name: "Souffle long", line: "labeur", mastery: 6,
     description: "Vous ne vous essoufflez plus. +15 énergie, +1 régén. d'énergie.",
     effects: [Stat((stat: MaxEnergy, kind: Flat, value: 15.0)), Stat((stat: EnergyRegen, kind: Flat, value: 1.0))]),
    (id: "cuir_tanne", name: "Peau tannée", line: "labeur", mastery: 12,
     description: "Les ampoules sont devenues de la corne. +8 armure, +1 régén. de vie.",
     effects: [Stat((stat: Armor, kind: Flat, value: 8.0)), Stat((stat: HpRegen, kind: Flat, value: 1.0))]),
    (id: "increvable", name: "Increvable", line: "labeur", mastery: 25,
     description: "Sous 30 % de PV : +40 % d'armure et de résistance.",
     effects: [StatWhile(cond: HpBelow(0.3), modifier: (stat: Armor, kind: Percent, value: 0.4)), StatWhile(cond: HpBelow(0.3), modifier: (stat: MagicResist, kind: Percent, value: 0.4))]),

    // ================= MAINS NUES =================
    (id: "poings_de_fer", name: "Poings de fer", line: "poings", mastery: 3, needs_equipped: true,
     description: "+30 % de vitesse d'attaque à mains nues.",
     effects: [Stat((stat: AttackSpeed, kind: Flat, value: 0.3))]),
    (id: "bagarreur", name: "Bagarreur", line: "poings", mastery: 12,
     description: "Entouré de 2 ennemis ou plus : +25 % de puissance physique.",
     effects: [StatWhile(cond: Surrounded(2), modifier: (stat: PhysicalPower, kind: Percent, value: 0.25))]),

    // ================= MASSES =================
    (id: "tete_dure", name: "Tête dure", line: "masse", mastery: 3, needs_equipped: true,
     description: "+10 % de ténacité, +15 % de PV.",
     effects: [Stat((stat: Tenacity, kind: Flat, value: 0.1)), Stat((stat: MaxHp, kind: Percent, value: 0.15))]),
    (id: "sonneur", name: "Sonneur de cloches", line: "masse", mastery: 20, needs_equipped: true,
     description: "Vos coups ont 12 % de chances d'étourdir.",
     effects: [OnHit(tag: Some(Melee), chance: 0.12, effect: Status(kind: Stun, duration: 0.6))]),
    (id: "gardien", name: "Gardien", line: "masse", mastery: 45,
     description: "+30 % de menace générée, +10 % d'armure.",
     effects: [Stat((stat: ThreatMult, kind: Flat, value: 0.3)), Stat((stat: Armor, kind: Percent, value: 0.1))]),

    // ================= ÉPÉES =================
    (id: "fil_du_rasoir", name: "Fil du rasoir", line: "epee", mastery: 3, needs_equipped: true,
     description: "Vos coups de mêlée ont 25 % de chances de faire saigner.",
     effects: [OnHit(tag: Some(Melee), chance: 0.25, effect: Status(kind: Bleed, duration: 4.0, magnitude: 1.0))]),
    (id: "maitre_d_armes", name: "Maître d'armes", line: "epee", mastery: 22, needs_equipped: true,
     description: "+8 % de critiques, +25 % de dégâts critiques.",
     effects: [Stat((stat: CritChance, kind: Flat, value: 0.08)), Stat((stat: CritDamage, kind: Flat, value: 0.25))]),
    (id: "riposte", name: "Riposte", line: "epee", mastery: 50,
     description: "Quand on vous frappe : 20 % de chances de gagner Galvanisé.",
     effects: [OnDamaged(chance: 0.2, effect: Status(kind: Empower, duration: 3.0, magnitude: 0.25), to_attacker: false, internal_cd: 4.0)]),

    // ================= HACHES =================
    (id: "soif_de_sang", name: "Soif de sang", line: "hache", mastery: 3, needs_equipped: true,
     description: "+5 % de vol de vie.",
     effects: [Stat((stat: Lifesteal, kind: Flat, value: 0.05))]),
    (id: "berserker", name: "Berserker", line: "hache", mastery: 20,
     description: "Sous 50 % de PV : +30 % de puissance physique et de vitesse d'attaque.",
     effects: [StatWhile(cond: HpBelow(0.5), modifier: (stat: PhysicalPower, kind: Percent, value: 0.3)), StatWhile(cond: HpBelow(0.5), modifier: (stat: AttackSpeed, kind: Flat, value: 0.3))]),
    (id: "boucher", name: "Boucher", line: "hache", mastery: 45, needs_equipped: true,
     description: "Les skills de saignement sont 25 % plus forts. Achever rend 10 % de PV.",
     effects: [TagPower(tag: Bleed, pct: 0.25), OnKill(effect: SelfHeal(base: 0.0, scaling: 0.1))]),

    // ================= LANCES =================
    (id: "allonge", name: "Allonge", line: "lance", mastery: 3, needs_equipped: true,
     description: "+10 % de vitesse de déplacement.",
     effects: [Stat((stat: MoveSpeed, kind: Percent, value: 0.1))]),
    (id: "cavalier", name: "Cavalier", line: "lance", mastery: 22,
     description: "Vos skills de mouvement sont 30 % plus forts et rechargent 20 % plus vite.",
     effects: [TagPower(tag: Movement, pct: 0.3), TagCooldown(tag: Movement, pct: 0.2)]),
    (id: "phalange", name: "Phalange", line: "lance", mastery: 48,
     description: "+12 % d'armure et 15 % de chances de ralentir en frappant.",
     effects: [Stat((stat: Armor, kind: Percent, value: 0.12)), OnHit(tag: None, chance: 0.15, effect: Status(kind: Slow, duration: 2.0, magnitude: 0.3))]),

    // ================= DAGUES =================
    (id: "venimeux", name: "Venimeux", line: "dague", mastery: 3, needs_equipped: true,
