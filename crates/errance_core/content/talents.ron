     effects: [Stat((stat: CritChance, kind: Flat, value: 0.05)), Stat((stat: AttackSpeed, kind: Flat, value: 0.1))]),
    (id: "pas_du_chasseur", name: "Pas du chasseur", line: "arc", mastery: 20,
     description: "+12 % de vitesse, +5 % d'esquive.",
