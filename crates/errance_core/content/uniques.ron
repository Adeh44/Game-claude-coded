// Objets uniques : rares, nommés, avec un effet spécial.
[
    // Récompense de la quête « Gérald le Borgne » : ne tombe jamais au hasard.
    (id: "eclat_de_gerald", name: "L'Œil de Gérald", base: "grande_hache", tier: 3, quest_only: true,
     lore: "La hache du Borgne. On dit qu'il voyait mieux avec elle qu'avec son œil restant.",
     mods: [(stat: CritChance, kind: Flat, value: 0.08)],
     effects: [OnKill(effect: SelfStatus(kind: Haste, duration: 4.0, magnitude: 0.4)), OnHit(tag: Some(Melee), chance: 0.15, effect: Status(kind: Bleed, duration: 4.0, magnitude: 2.0))]),
    (id: "torche_du_premier_porteur", name: "Torche du Premier Porteur", base: "torche", tier: 2,
     lore: "Toutes les grandes compagnies ont commencé par quelqu'un qui tenait la lumière.",
     mods: [(stat: MaxHp, kind: Percent, value: 0.08)],
     effects: [Stat((stat: EnergyRegen, kind: Flat, value: 2.0)), TagPower(tag: Fire, pct: 0.2)]),
    (id: "cloche_de_bronze", name: "La Cloche", base: "masse", tier: 3,
     lore: "Une masse fondue dans la cloche d'un temple brûlé. Elle sonne encore.",
     mods: [(stat: ThreatMult, kind: Flat, value: 0.3)],
     effects: [OnHit(tag: Some(Melee), chance: 0.2, effect: Status(kind: Stun, duration: 0.7)), Stat((stat: Tenacity, kind: Flat, value: 0.1))]),
    (id: "givrelame", name: "Givrelame", base: "epee_longue", tier: 4,
     lore: "Forgée dans la glace d'un lac qui ne dégèle jamais.",
     mods: [(stat: MagicPower, kind: Flat, value: 10.0)],
     effects: [OnHit(tag: None, chance: 0.35, effect: Status(kind: Chill, duration: 3.0)), TagPower(tag: Frost, pct: 0.2)]),
    (id: "bure_du_pelerin", name: "Bure du Pèlerin", base: "robe", tier: 2,
     lore: "Usée par mille routes. Ceux qui la portent ne se perdent jamais tout à fait.",
     mods: [(stat: MoveSpeed, kind: Flat, value: 0.4)],
     effects: [OnHeal(effect: Status(kind: Haste, duration: 2.0, magnitude: 0.3)), Stat((stat: HealPower, kind: Percent, value: 0.15))]),
    (id: "anneau_du_vagabond", name: "Anneau du Vagabond", base: "anneau", tier: 1,
     lore: "Trouvé dans la boue. Il porte une inscription : « Rien ne dure, sauf le chemin ».",
     mods: [(stat: MaxHp, kind: Flat, value: 10.0)],
     effects: [StatWhile(cond: HpBelow(0.4), modifier: (stat: DodgeChance, kind: Flat, value: 0.15))]),
]
