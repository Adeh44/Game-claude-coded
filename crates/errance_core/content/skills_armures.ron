// Skills d'armure : chaque pièce (tête, torse, pieds) de chaque poids
// (tissu, cuir, plaque) offre des skills. Un mage en plaques peut provoquer,
// un guerrier en tissu peut accélérer ses sorts... c'est le principe.
[
    // ================= PLAQUES =================
    (id: "provocation", name: "Provocation", line: "plaque", slot: Head,
     description: "Tous les ennemis proches vous attaquent.",
     cost: 8.0, cooldown: 14.0, targeting: AreaAroundSelf(radius: 6.0),
     effects: [Taunt(duration: 3.0), Threat(amount: 20.0)],
     tags: [Taunt]),
    (id: "heaume_inebranlable", name: "Inébranlable", line: "plaque", slot: Head, mastery: 15,
     description: "Vous devenez insensible aux contrôles et retirez vos malus.",
