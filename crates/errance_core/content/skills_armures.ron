     effects: [Cleanse, SelfStatus(kind: Fortify, duration: 3.0, magnitude: 0.15)],
     tags: [Defense]),
    (id: "rempart", name: "Rempart", line: "plaque", slot: Chest,
     description: "Un gros bouclier selon vos PV max.",
     cost: 10.0, cooldown: 20.0, targeting: SelfOnly,
     effects: [SelfShield(base: 10.0, scaling: 0.2, duration: 6.0)],
     tags: [Defense, Shield]),
    (id: "epines_d_acier", name: "Épines d'acier", line: "plaque", slot: Chest, mastery: 18,
