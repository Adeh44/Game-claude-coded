     effects: [SelfStatus(kind: Thorns, duration: 8.0, magnitude: 0.5), SelfStatus(kind: Fortify, duration: 8.0, magnitude: 0.1)],
     tags: [Defense]),
    (id: "charge_blindee", name: "Charge blindée", line: "plaque", slot: Feet,
