     cost: 10.0, cooldown: 14.0, targeting: Dash(distance: 7.0, radius: 1.5),
     effects: [Taunt(duration: 2.0), Status(kind: Slow, duration: 2.0, magnitude: 0.4), Threat(amount: 10.0)],
     tags: [Movement, Taunt]),
    (id: "pas_lourd", name: "Pas lourd", line: "plaque", slot: Feet, mastery: 12,
     description: "Vous ne pouvez plus être déplacé et marchez plus vite.",
     cost: 8.0, cooldown: 18.0, targeting: SelfOnly,
     effects: [Cleanse, SelfStatus(kind: Haste, duration: 4.0, magnitude: 0.4)],
     tags: [Movement]),

