// Skills des armes de départ : mains nues et masses/gourdins.
// Rappel : Damage(base + scaling × puissance). Les attaques de base (slot Basic)
// utilisent `cooldown` comme durée entre deux coups.
[
    // ================= MAINS NUES =================
    (id: "poing", name: "Coup de poing", line: "poings", slot: Basic,
     description: "Un poing. C'est tout ce que vous avez.",
     cooldown: 0.9, targeting: Enemy(range: 1.3),
     effects: [Damage(kind: Physical, base: 2.0, scaling: 0.5)],
     tags: [Melee, Basic, Physical]),
    (id: "coup_de_pied", name: "Coup de pied", line: "poings", slot: Weapon1,
     description: "Repousse un adversaire trop collant.",
     cost: 8.0, cooldown: 6.0, targeting: Enemy(range: 1.5),
     effects: [Damage(kind: Physical, base: 5.0, scaling: 0.8), Knockback(distance: 2.5)],
     tags: [Melee]),
    (id: "crochet", name: "Crochet au menton", line: "poings", slot: Weapon1, mastery: 6,
     description: "Un coup sec qui sonne.",
     cost: 10.0, cooldown: 9.0, targeting: Enemy(range: 1.4),
     effects: [Damage(kind: Physical, base: 6.0, scaling: 1.0), Status(kind: Stun, duration: 0.8)],
     tags: [Melee]),
    (id: "rafale_de_coups", name: "Rafale de coups", line: "poings", slot: Weapon1, mastery: 18,
     description: "Trois coups rapides, le dernier fait saigner.",
     cost: 14.0, cooldown: 7.0, targeting: Enemy(range: 1.4),
     effects: [Damage(kind: Physical, base: 9.0, scaling: 1.5), Status(kind: Bleed, duration: 4.0, magnitude: 1.5, stacks: 2)],
     tags: [Melee]),
    (id: "esquive_maladroite", name: "Esquive maladroite", line: "poings", slot: Weapon2,
     description: "Vous roulez en arrière, pas très élégamment.",
     cost: 8.0, cooldown: 10.0, targeting: Leap(distance: 3.5, radius: 0.0),
     effects: [SelfStatus(kind: Evasion, duration: 2.0, magnitude: 0.3)],
     tags: [Movement]),
    (id: "garde_haute", name: "Garde haute", line: "poings", slot: Weapon2, mastery: 10,
     description: "Les bras devant le visage : vous encaissez mieux.",
     cost: 10.0, cooldown: 14.0, targeting: SelfOnly,
     effects: [SelfStatus(kind: Fortify, duration: 4.0, magnitude: 0.3)],
     tags: [Defense]),
    (id: "rage_du_desespoir", name: "Rage du désespoir", line: "poings", slot: Weapon3, mastery: 4,
     description: "Quand on n'a plus rien à perdre. Plus fort, plus vite.",
     cost: 15.0, cooldown: 25.0, targeting: SelfOnly,
     effects: [SelfStatus(kind: Empower, duration: 6.0, magnitude: 0.4), SelfStatus(kind: Haste, duration: 6.0, magnitude: 0.3)],
     tags: [Buff]),
    (id: "bagarre_generale", name: "Bagarre générale", line: "poings", slot: Weapon3, mastery: 25,
     description: "Vous tapez tout ce qui bouge autour de vous.",
     cost: 20.0, cooldown: 18.0, targeting: AreaAroundSelf(radius: 2.5),
     effects: [Damage(kind: Physical, base: 12.0, scaling: 1.6), Status(kind: Stun, duration: 0.5)],
     tags: [Melee]),

    // ================= MASSES & GOURDINS =================
    (id: "coup_de_masse", name: "Coup de masse", line: "masse", slot: Basic,
